<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sadis Cakes and More - Cakes, cupcakes, small chops, samosa and money bouquets in Jos and Bauchi.">
  <title>Sadis Cakes and More</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Allura&family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap');

    :root {
      --cream: #fff8ea;
      --cream2: #f8edd8;
      --navy: #0c2340;
      --navy2: #163b66;
      --gold: #c89b3c;
      --brown: #3d2b1f;
      --pink: #e7a4b5;
      --white: #ffffff;
      --shadow: 0 10px 30px rgba(12,35,64,.10);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Poppins, Arial, sans-serif;
      color: var(--brown);
      background: var(--cream);
      line-height: 1.7;
    }
    a { color: inherit; text-decoration: none; }

    header {
      background: rgba(255,248,234,.96);
      position: sticky;
      top: 0;
      z-index: 20;
      border-bottom: 1px solid rgba(200,155,60,.25);
      backdrop-filter: blur(8px);
    }
    nav {
      max-width: 1150px;
      margin: auto;
      min-height: 72px;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand {
      font-family: Allura, cursive;
      font-size: 39px;
      color: var(--navy);
      line-height: 1;
      white-space: nowrap;
    }
    .brand span {
      display: block;
      font-family: "Playfair Display", serif;
      font-size: 12px;
      letter-spacing: 3px;
      color: var(--gold);
      text-transform: uppercase;
      text-align: center;
      margin-top: 4px;
    }
    .nav-links { display: flex; gap: 22px; font-weight: 600; font-size: 14px; }
    .nav-links a:hover { color: var(--gold); }

    .hero {
      min-height: 620px;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 80px 20px;
      background:
        radial-gradient(circle at 20% 20%, rgba(200,155,60,.16), transparent 28%),
        radial-gradient(circle at 80% 30%, rgba(12,35,64,.08), transparent 30%),
        linear-gradient(135deg, var(--cream), var(--cream2));
    }
    .hero-card { max-width: 850px; }
    .eyebrow {
      color: var(--gold);
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-size: 13px;
    }
    h1 {
      font-family: Allura, cursive;
      font-size: clamp(70px, 13vw, 130px);
      line-height: .9;
      color: var(--navy);
      margin: 14px 0 4px;
    }
    .hero-subtitle {
      font-family: "Playfair Display", serif;
      font-size: clamp(19px, 3vw, 28px);
      color: var(--gold);
      letter-spacing: 4px;
      text-transform: uppercase;
    }
    .hero p { max-width: 650px; margin: 22px auto 30px; font-size: 16px; }
    .btns { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 22px;
      border-radius: 999px;
      font-weight: 700;
      border: 2px solid var(--navy);
      transition: .2s;
    }
    .btn-primary { background: var(--navy); color: white; }
    .btn-secondary { color: var(--navy); background: transparent; }
    .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
    .btn-primary:hover { background: var(--navy2); }

    section { padding: 78px 20px; }
    .section-inner { max-width: 1150px; margin: auto; }
    .section-title { text-align: center; margin-bottom: 38px; }
    .section-title h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(30px, 5vw, 43px);
      color: var(--navy);
    }
    .section-title p { margin-top: 8px; color: #705e50; }

    .services { background: white; }

    .service-list {
      max-width: 500px;
      margin: auto;
      background: var(--cream);
      padding: 25px 35px;
      border-radius: 18px;
      border: 1px solid rgba(200,155,60,.22);
      box-shadow: var(--shadow);
    }

    .service-list p {
      color: var(--navy);
      font-size: 18px;
      font-weight: 600;
      padding: 8px 0;
    }

    .about-wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 45px;
      align-items: center;
    }
    .about-box {
      background: white;
      padding: 34px;
      border-radius: 22px;
      box-shadow: var(--shadow);
      border-left: 5px solid var(--gold);
    }
    .about-box h3 { color: var(--navy); font-family: "Playfair Display", serif; font-size: 27px; margin-bottom: 10px; }
    .locations {
      display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px;
    }
    .location {
      background: var(--navy); color: white; padding: 8px 14px; border-radius: 999px; font-size: 13px;
    }

    .gallery { background: white; }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
    }
    .photo {
      aspect-ratio: 1 / 1;
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      background: linear-gradient(135deg, #efe1c5, #fff9ee);
      border: 2px dashed rgba(12,35,64,.25);
      display: grid;
      place-items: center;
      text-align: center;
      padding: 10px;
      color: var(--navy);
      font-weight: 600;
    }

    /* FIXED GALLERY IMAGES */
    .photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .placeholder small {
      display: block;
      color: #8a7562;
      font-weight: 400;
      margin-top: 4px;
    }

    .why-grid { grid-template-columns: repeat(4, 1fr); }
    .why-card {
      background: white;
      padding: 25px 15px;
      text-align: center;
      border-radius: 18px;
      border: 1px solid rgba(200,155,60,.22);
      box-shadow: var(--shadow);
    }
    .service-icon { font-size: 38px; margin-bottom: 8px; }
    .why-card h3 { color: var(--navy); margin: 8px 0; font-size: 17px; }

    .reviews { background: var(--cream2); }
    .review-form {
      max-width: 700px;
      margin: 0 auto 35px;
      background: white;
      padding: 25px;
      border-radius: 20px;
      box-shadow: var(--shadow);
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    input, textarea, select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d8c7ac;
      border-radius: 10px;
      font: inherit;
      margin-bottom: 12px;
      background: #fffdf8;
    }
    textarea { min-height: 100px; resize: vertical; }
    .review-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .review {
      background: white;
      padding: 22px;
      border-radius: 18px;
      box-shadow: var(--shadow);
    }
    .stars { color: var(--gold); letter-spacing: 2px; }
    .review strong { color: var(--navy); display: block; margin-top: 8px; }

    .contact { background: var(--navy); color: white; }
    .contact .section-title h2, .contact .section-title p { color: white; }
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .contact-card {
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.15);
      padding: 25px;
      border-radius: 18px;
      text-align: center;
    }
    .contact-card h3 { color: #f2d58c; margin-bottom: 7px; }
    .contact-card a:hover { color: #f2d58c; }

    footer {
      background: #081a30;
      color: white;
      text-align: center;
      padding: 22px 15px;
      font-size: 13px;
    }
    footer .copyright { color: var(--pink); }

    .floating-order {
      position: fixed;
      left: 14px;
      bottom: 20px;
      z-index: 50;
      background: var(--navy);
      color: white;
      border: 2px solid var(--gold);
      border-radius: 999px;
      padding: 12px 17px;
      font-weight: 700;
      box-shadow: 0 8px 25px rgba(0,0,0,.22);
    }
    .floating-order:hover { background: var(--navy2); }

    @media (max-width: 900px) {
      .service-list { max-width: 500px; }
      .gallery-grid { grid-template-columns: repeat(3, 1fr); }
      .why-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 700px) {
      .nav-links { display: none; }
      .about-wrap, .contact-grid, .review-list { grid-template-columns: 1fr; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
      section { padding: 58px 15px; }
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .brand { font-size: 33px; }
      .floating-order { left: 10px; bottom: 14px; padding: 10px 14px; }
    }
  </style>
</head>

